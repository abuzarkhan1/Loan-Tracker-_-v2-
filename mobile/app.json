{
  "expo": {
    "name": "Loan Tracker",
    "slug": "loan-tracker",
    "description": "A polished loan and daily money tracking app for contacts, repayments, expenses, income, and balances.",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "scheme": "loantracker",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "primaryColor": "#635bff",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/4875db44-da90-46c5-bf17-46a7b84674de"
    },
    "ios": {
      "bundleIdentifier": "com.abuzar.loantracker",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": false,
      "backgroundColor": "#ffffff",
      "userInterfaceStyle": "automatic",
      "icon": "./assets/logo.png",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.abuzar.loantracker",
      "versionCode": 1,
      "backgroundColor": "#ffffff",
      "userInterfaceStyle": "automatic",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "name": "Loan Tracker",
      "shortName": "LoanTrack",
      "favicon": "./assets/logo.png",
      "themeColor": "#635bff",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "./node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/fira-code/400Regular/FiraCode_400Regular.ttf"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow Loan Tracker to protect your quick login with Face ID or biometrics."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Loan Tracker to use Face ID or biometrics for quick login."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0b0f19",
            "image": "./assets/logo.png"
          }
        }
      ]
    ],
    "extra": {
      "previewChannel": "preview",
      "eas": {
        "projectId": "4875db44-da90-46c5-bf17-46a7b84674de"
      }
    }
  }
}
